# Copy this file to .streamlit/secrets.toml and fill in real values.
# Local: paste into .streamlit/secrets.toml (already gitignored).
# Streamlit Cloud: paste the same keys into app Settings -> Secrets.
#
# Uses the same Supabase project + R2 bucket as streamlit_case_app — objects
# and tables are namespaced (PREFIX="research-app", table "feedback") so the
# two apps don't collide.

postgres_url = "postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres"

[r2]
account_id = "your-cloudflare-account-id"
access_key_id = "your-r2-access-key-id"
secret_access_key = "your-r2-secret-access-key"
bucket = "lichen-images"
